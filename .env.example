# WhatsApp Business Platform (Cloud API) webhook'u
# Meta panelindeki "Verify token" ile aynı olmalı (kendiniz belirlersiniz)
WHATSAPP_VERIFY_TOKEN=
# Meta uygulamasının App Secret'ı (X-Hub-Signature-256 imzası bununla doğrulanır)
WHATSAPP_APP_SECRET=

# Bayi portalı oturum çerezini imzalamak için uzun, rastgele bir değer
PORTAL_OTURUM_SECRET=

# Supabase: Project Settings › API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Gizli anahtar (sb_secret_… ya da service_role) — yalnızca sunucuda, oturumsuz işler (webhook, cihaz bildirimi, zamanlayıcılar) için
SUPABASE_SECRET_KEY=
# Uygulamanın açık adresi (e-posta onay / şifre sıfırlama bağlantıları ve zamanlayıcı için)
SITE_URL=
