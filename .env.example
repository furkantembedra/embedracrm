# Embedra CRM ortam değişkenleri. Kopyala: cp .env.example .env.local
# Gerçek değerler yalnızca .env.local'a ve Vercel'e girilir; bu dosyaya asla yazılmaz.
# Ayrıntılı kurulum ve her değişkenin nereden alındığı: docs/BOT_KURULUM.md
# [GİZLİ] = Vercel'de "Sensitive" olarak işaretle. Rastgele sır üretmek için: openssl rand -base64 48

# ── Supabase: Project Settings › API Keys ───────────────────────────────────
# Herkese açık: derlemede tarayıcı paketine gömülür (güvenliği RLS sağlar)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# [GİZLİ] Gizli anahtar (sb_secret_… ya da service_role). RLS'i atlar. Yalnızca sunucuda, oturumsuz işler
# (webhook, cihaz bildirimi, abonelikten çıkma, zamanlayıcılar) için
SUPABASE_SECRET_KEY=

# ── Uygulama ─────────────────────────────────────────────────────────────────
# Uygulamanın açık adresi, sonunda / olmadan (ör. https://crm.example.com). E-posta onay ve şifre sıfırlama
# bağlantıları, kampanya bağlantıları ve zamanlayıcı için. Kullanmayacaksanız satırı yorumda bırakın:
# bazı yerler ?? ile okuduğu için boş değer (SITE_URL=) adres yerine boş metin olarak kullanılır.
# SITE_URL=https://crm.example.com
# [GİZLİ] Bayi portalı oturum çerezini imzalar (production'da zorunlu)
PORTAL_OTURUM_SECRET=
# [GİZLİ] Abonelikten çıkma bağlantılarını imzalar (production'da zorunlu)
ABONELIK_SIRRI=
# [GİZLİ] ONESuite cihaz anahtarlarını üretir ve doğrular (production'da zorunlu).
# Dikkat: değiştirilirse sahadaki cihazlara yazılmış anahtarlar geçersiz olur.
CIHAZ_BILDIRIM_SIRRI=
# [GİZLİ] /api/kampanya-zamanlayici çağrısı için: Authorization: Bearer <CRON_SECRET> (Vercel Cron kendisi ekler)
CRON_SECRET=

# ── WhatsApp Business Platform (Cloud API) ──────────────────────────────────
# [GİZLİ] Meta webhook doğrulama token'ı. Meta panelindeki "Verify token" ile aynı olmalı (kendiniz belirlersiniz)
WHATSAPP_VERIFY_TOKEN=
# [GİZLİ] Meta uygulamasının App Secret'ı (App settings › Basic). X-Hub-Signature-256 imzası bununla doğrulanır.
# Production'da tanımlı değilse tüm webhook istekleri reddedilir.
WHATSAPP_APP_SECRET=
# [GİZLİ] System User'ın süresiz erişim token'ı (whatsapp_business_messaging, whatsapp_business_management)
WHATSAPP_TOKEN=
# [GİZLİ] Gönderen numaranın Phone number ID'si (telefon numarasının kendisi değil). Token ile birlikte boşsa demo modu.
WHATSAPP_PHONE_ID=
# İsteğe bağlı: pazarlama şablonlarının dil kodu (varsayılan tr). Boş bırakmayın; gerekmiyorsa yorumda kalsın.
# WHATSAPP_SABLON_DILI=tr

# ── E-posta (Resend) ────────────────────────────────────────────────────────
# [GİZLİ] Resend API anahtarı. EPOSTA_GONDEREN ile birlikte boşsa demo modu.
RESEND_API_KEY=
# Gönderen; alan adı Resend'de doğrulanmış olmalı, ör. Embedra <bulten@example.com>
EPOSTA_GONDEREN=

# ── Anthropic (AI satış botu, P2.1'den itibaren) ────────────────────────────
# [GİZLİ] Bot workspace'inde oluşturulan API anahtarı. Boşsa bot kapalıdır.
# Console'da organizasyon ve workspace için aylık harcama limiti koyun.
ANTHROPIC_API_KEY=

# ── Yalnızca testler ve araçlar (production'da TANIMLAMAYIN) ────────────────
# META_GRAPH_URL=http://localhost:<port>      # Graph API'yi sahte sunucuya yönlendirir (test/sahte/meta.ts)
# ANTHROPIC_BASE_URL=http://localhost:<port>  # Claude API'yi sahte sunucuya yönlendirir (test/sahte/anthropic.ts)
# CRM_ADRESI=http://localhost:3000            # npm run cihaz-bildir simülatörünün hedefi
